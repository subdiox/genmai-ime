<?xml version="1.0" encoding="utf-8"?>
<!--
 Port of mozc/src/mac/installer/distribution.xml (3.35.6354) for the Swift port.
 Differences: the package id / file name (io.github.subdiox.genmai.pkg, Genmai.pkg) so that the C++
 Mozc package (org.mozc.pkg.JapaneseInput) is not treated as the same product, the title, the minimum OS
 (the Swift package targets macOS 15) and hostArchitectures, which Tools/make_installer_pkg.sh fills with
 the architectures of the built binaries (@@@HOST_ARCHITECTURES@@@), and no logout at the end: the postinstall
 script restarts the input method (there are no launch agents to load), so updates take effect at once.
 Not in Mozc: localized welcome and conclusion pages (Resources/{en,ja}.lproj/*.html) and the app icon as the
 background in both appearances (background.tiff, made from Tools/assets/genmai.icns by make_installer_pkg.sh).
-->

<installer-gui-script minSpecVersion="1">
    <title>Genmai</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>
    <allowed-os-versions>
        <os-version min="15.0"/>
    </allowed-os-versions>
    <pkg-ref id="io.github.subdiox.genmai.pkg"/>
    <domains enable_localSystem="true"/>
    <options rootVolumeOnly="true"/>
    <options customize="never" require-scripts="false" hostArchitectures="@@@HOST_ARCHITECTURES@@@"/>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.subdiox.genmai.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.subdiox.genmai.pkg" visible="false">
        <pkg-ref id="io.github.subdiox.genmai.pkg"/>
    </choice>
    <pkg-ref id="io.github.subdiox.genmai.pkg" version="0" onConclusion="None">Genmai.pkg</pkg-ref>
</installer-gui-script>
